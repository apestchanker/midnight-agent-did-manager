pragma language_version >= 0.23 && <= 0.23;

import CompactStandardLibrary;

// =====================================================================
// UNIFIED GATED DID REGISTRY — v3.0.0
// =====================================================================
// Colapsa token_gating.compact + did_registry.compact en un único
// contrato. El token de acción deja de ser un commitment reconstruible
// off-chain y pasa a ser un ShieldedCoinInfo real consumido inline por
// el helper consumeToken. Ver sdd/wip/unified-gated-did-registry/.
// =====================================================================

// === TOKEN GATING STATE ===
// Colores de tokens minteados/aceptados por este contrato.
export ledger valid_colors: Map<Bytes<32>, Boolean>;

// Anti-replay: nullifier_proxy de cada coin consumido. Único registro de replay.
export ledger used_capability_nullifiers: Map<Bytes<32>, Boolean>;

// === DID REGISTRY STATE ===
export ledger registry_salt: Bytes<32>;

export ledger admin_registered: Boolean;

export ledger initial_admin: ZswapCoinPublicKey;

export ledger did_controller: Map<Bytes<32>, ZswapCoinPublicKey>;

export ledger role_by_key: Map<Bytes<32>, Boolean>;

export ledger party_status: Map<Bytes<32>, Uint<8>>;

export ledger did_commitments: Map<Bytes<32>, Bytes<32>>;

export ledger document_commitments: Map<Bytes<32>, Bytes<32>>;

export ledger proof_commitments: Map<Bytes<32>, Bytes<32>>;

// Renombrado de capability_commitments (did_registry, did_key→cap_commitment
// para updates) para eliminar la ambigüedad con el map de token_gating (ADR-007).
export ledger update_cap_commitments: Map<Bytes<32>, Bytes<32>>;

export ledger revocation_commitments: Map<Bytes<32>, Bytes<32>>;

export ledger total_active_dids: Uint<64>;

export ledger registry_nonce: Counter;

export ledger did_token_color: Map<Bytes<32>, Bytes<32>>;

// Color único del admin token (feature 005-coin-gated-admin-access, ADR-003).
// Valor único, fijado una vez en el constructor, nunca reasignado.
export ledger admin_token_color: Bytes<32>;

// === CONSTRUCTOR ===
// ---------------------------------------------------------------------------
// DECISIÓN EXPLÍCITA DEL OWNER DEL PROYECTO — 2026-07-21. NO REVERTIR SIN SU
// AUTORIZACIÓN EXPLÍCITA. Ver también sdd/wip/005-coin-gated-admin-access/.
//
// Esta es la segunda vez que cambia la forma del bootstrap de admin:
//   1. Pre-005: register_initial_admin() en dos pasos, gateado por
//      ownPublicKey() — forgeable (ver commit 3cd3f20), vulnerabilidad real.
//   2. 005-coin-gated-admin-access: se cerró la vulnerabilidad Y se hizo
//      atómico (deploy + mint del admin token en la MISMA tx del constructor).
//   3. ESTE CAMBIO (2026-07-21): el owner pidió deshacer solo la ATOMICIDAD,
//      no el mecanismo. Evaluó el riesgo de carrera (otro caller podría
//      llamar register_initial_admin() antes que el deployer legítimo) y lo
//      ACEPTÓ conscientemente — su mitigación explícita es descartar el
//      contrato y redeployar uno nuevo si eso llegara a pasar. Este contrato
//      no tiene valor real en producción todavía (preprod/testnet).
//
// El root of trust SIGUE SIENDO coin-based, no ownPublicKey() — eso NO
// cambió. register_initial_admin() (más abajo) sigue minteando un
// ShieldedCoinInfo real, igual que hacía este constructor antes. Solo se
// separó en dos transacciones porque la construcción atómica del
// ZswapOutput del admin token en la misma tx que el deploy del contrato
// estaba interfiriendo con el balanceo de la wallet (ver debugging de deploy
// del 2026-07-21).
//
// Si en el futuro alguien considera "arreglar" esto volviendo a la versión
// atómica: ya se evaluó y se rechazó explícitamente. Consultar con el owner
// del proyecto primero.
// ---------------------------------------------------------------------------
constructor(salt: Bytes<32>) {
  registry_salt = disclose(salt);
  total_active_dids = 0 as Uint<64>;
  admin_registered = false;
  // BUG REAL ENCONTRADO Y CORREGIDO — 2026-07-22. NO volver a fijar
  // admin_token_color acá. Se verificó on-chain, contra dos deploys reales
  // y distintos en preprod (direcciones de contrato distintas, confirmado
  // vía registry_salt distinto), que `tokenType(adminDomainSep(),
  // kernel.self())` evaluado DENTRO DEL CONSTRUCTOR devuelve el MISMO color
  // para contratos distintos — kernel.self() no se comporta ahí como un
  // identificador único por-contrato. Eso rompía el modelo de seguridad
  // completo (el admin token dejaba de estar atado a un contrato
  // específico). El cálculo real y correcto ahora vive en
  // register_initial_admin() (más abajo), en el mismo circuit donde
  // mintShieldedToken() realmente mintea el coin — ver el comentario ahí
  // para el detalle completo.
}

// === HELPERS PURE ===
circuit deriveDidKey(controller: ZswapCoinPublicKey, subject_nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
           [pad(32, "didmn:did:v1"), registry_salt, controller.bytes, subject_nonce]
           );
}

pure circuit roleKey(controller: ZswapCoinPublicKey, role: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([controller.bytes, role]);
}

pure circuit adminRole(): Bytes<32> {
  return pad(32, "ADMIN");
}

// Domain separator fijo, contract-wide, del admin token (feature
// 005-coin-gated-admin-access, ADR-001/ADR-003). Distinto de los domain
// separators per-subscription usados por mint_capability_tokens, así que
// admin_token_color no puede colisionar con ningún color de capability token.
pure circuit adminDomainSep(): Bytes<32> {
  return pad(32, "didmn:admin-token:v1");
}

pure circuit userRole(): Bytes<32> {
  return pad(32, "USER");
}

// === NO GATEADO: bootstrap del admin — segunda TX, separada del deploy ===
// DECISIÓN EXPLÍCITA DEL OWNER (2026-07-21) — ver el comentario extenso en
// el constructor antes de tocar esto. Sin gating adicional a propósito:
// quien llame primero se queda con el admin token génesis (riesgo de carrera
// aceptado explícitamente por el owner). Sigue siendo coin-based, no
// ownPublicKey() — la única diferencia respecto al diseño 005 original es
// que esto ahora vive en su propia transacción en vez de correr dentro del
// constructor.
export circuit register_initial_admin(
                 admin_recipient: ZswapCoinPublicKey,
                 admin_coin_nonce: Bytes<32>,
                 admin_supply: Uint<64>
                 ): [] {
  assert(!admin_registered, "Admin already registered");
  assert(disclose(admin_supply) >= (1 as Uint<64>), "admin_supply must be at least 1");

  const public_recipient = disclose(admin_recipient);
  const public_nonce = disclose(admin_coin_nonce);
  const public_supply = disclose(admin_supply);
  const total = (public_supply + (1 as Uint<64>)) as Uint<64>;

  // Fix 2026-07-22 (ver el comentario en el constructor): admin_token_color
  // se calcula ACÁ, en el mismo circuit donde mintShieldedToken() realmente
  // mintea el coin — no en el constructor, donde kernel.self() demostró NO
  // devolver un valor único por-contrato (verificado on-chain contra dos
  // deploys reales con el mismo resultado). Fijarlo en el mismo circuit que
  // hace el mint garantiza por construcción que el bookkeeping del ledger
  // coincide exactamente con el color del coin que efectivamente se emite.
  admin_token_color = tokenType(adminDomainSep(), kernel.self());

  mintShieldedToken(
    adminDomainSep(),
    total,
    public_nonce,
    left<ZswapCoinPublicKey, ContractAddress>(public_recipient)
    );

  // Bookkeeping de solo-lectura para deriveRegistryAccess() (no es fuente de
  // autorización — consumeAdminToken() es el único gate para operaciones
  // admin-tier).
  admin_registered = true;
  initial_admin = public_recipient;
  role_by_key.insert(roleKey(public_recipient, adminRole()), true);
  role_by_key.insert(roleKey(public_recipient, userRole()), true);
}

// === HELPER INTERNO: consumeToken (ADR-003) ===
// Único punto de verdad del gating. Valida color y value, enforce single-use
// vía nullifier_proxy, toma custodia del coin y devuelve all-but-1 al caller en
// la misma transacción. No exportado, no pure (toca ledger y monedas).
circuit consumeToken(coin: ShieldedCoinInfo): [] {
  assert(valid_colors.member(disclose(coin.color)), "Invalid token color");
  assert(disclose(coin.value) >= (2 as Uint<128>), "Insufficient token value");
  // Nullifier namespaced por color (fix post-quality-gate) para que el mismo
  // nonce en dos colores distintos no colisione en used_capability_nullifiers.
  const nullifier_proxy = persistentHash<Vector<2, Bytes<32>>>(
                             [disclose(coin.color), disclose(coin.nonce)]
                             );
  assert(!used_capability_nullifiers.member(nullifier_proxy), "Token already used");
  receiveShielded(disclose(coin));
  const remaining = (disclose(coin.value) - (1 as Uint<128>)) as Uint<128>;
  sendImmediateShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    remaining
    );
  used_capability_nullifiers.insert(nullifier_proxy, true);
}

// === HELPER INTERNO: consumeAdminToken (feature 005-coin-gated-admin-access, ADR-001) ===
// Near-clone estructural de consumeToken(): misma mecánica de posesión y
// consumo (single-use vía nullifier, custodia del coin, devuelve change),
// pero valida igualdad EXACTA contra admin_token_color (un solo color) en
// vez de membership en el set valid_colors (muchos colores de capability
// token). Comparte el mismo used_capability_nullifiers map — no existe un
// used_admin_nullifiers separado (ver ADR-001). No exportado, no pure.
circuit consumeAdminToken(coin: ShieldedCoinInfo): [] {
  assert(disclose(coin.color) == admin_token_color, "Invalid admin token color");
  assert(disclose(coin.value) >= (2 as Uint<128>), "Insufficient admin token value");
  // Nullifier namespaced por color (fix post-quality-gate), consistente con
  // consumeToken() — mismo mapa compartido used_capability_nullifiers.
  const nullifier_proxy = persistentHash<Vector<2, Bytes<32>>>(
                             [disclose(coin.color), disclose(coin.nonce)]
                             );
  assert(!used_capability_nullifiers.member(nullifier_proxy), "Admin token already used");
  receiveShielded(disclose(coin));
  const remaining = (disclose(coin.value) - (1 as Uint<128>)) as Uint<128>;
  sendImmediateShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    remaining
    );
  used_capability_nullifiers.insert(nullifier_proxy, true);
}

// === GATEADO: mint de tokens (solo Admin, feature 005-coin-gated-admin-access, ADR-001/ADR-004) ===
export circuit mint_capability_tokens(
                 coin: ShieldedCoinInfo,
                 subscription_key: Bytes<32>,
                 recipient: ZswapCoinPublicKey,
                 coin_nonce: Bytes<32>,
                 amount: Uint<64>
                 ): [] {
  // consumeAdminToken(coin) como PRIMERA instrucción — reemplaza
  // assertRole(adminRole()) (forgeable vía ownPublicKey(), ver 005 ADR-001/ADR-004).
  consumeAdminToken(coin);

  assert(amount >= (1 as Uint<64>), "Amount must be >= 1");

  const public_sub_key = disclose(subscription_key);
  const public_recipient = disclose(recipient);
  const public_coin_nonce = disclose(coin_nonce);
  const public_amount = disclose(amount);

  // Color único por usuario, derivado de la subscription_key elegida por el admin.
  const domain_sep = persistentHash<Bytes<32>>(public_sub_key);

  // Mintea amount+1: 1 unidad es el anchor (prueba suscripción activa), resto acciones.
  const total = (public_amount + (1 as Uint<64>)) as Uint<64>;

  mintShieldedToken(
    domain_sep,
    total,
    public_coin_nonce,
    left<ZswapCoinPublicKey, ContractAddress>(public_recipient)
    );

  // Registra el color para que consumeToken lo acepte.
  const minted_color = tokenType(domain_sep, kernel.self());
  if (!valid_colors.member(minted_color)) {
    valid_colors.insert(minted_color, true);
  }
}

// === GATEADO: registro atómico DID + token (REQ-01) ===
export circuit gated_self_register_did(coin: ShieldedCoinInfo, subject_nonce: Bytes<32>): Bytes<32> {
  // 1. Pre-checks de estado ANTES de consumeToken (ADR-004)
  assert(admin_registered, "Registry not yet bootstrapped");
  const controller = ownPublicKey();
  const public_nonce = disclose(subject_nonce);
  const did_key = disclose(deriveDidKey(controller, public_nonce));
  assert(!did_controller.member(did_key), "DID already registered");

  // 2. Consume token (gating real)
  consumeToken(coin);

  // 3. Registrar DID
  did_controller.insert(did_key, controller);
  party_status.insert(did_key, 1 as Uint<8>);
  did_token_color.insert(did_key, disclose(coin.color));

  const user_key = roleKey(controller, userRole());
  if (!role_by_key.member(user_key)) {
    role_by_key.insert(user_key, true);
  }

  return did_key;
}

// === GATEADO: solicitud de actualización de DID (REQ-05) ===
export circuit request_update_did(
                 coin: ShieldedCoinInfo,
                 subject_nonce: Bytes<32>,
                 doc_commitment: Bytes<32>,
                 cap_commitment: Bytes<32>
                 ): [] {
  const controller = ownPublicKey();
  const public_nonce = disclose(subject_nonce);
  const did_key = disclose(deriveDidKey(controller, public_nonce));

  // Precondiciones ANTES de consumeToken (ADR-004)
  assert(did_controller.member(did_key), "DID not registered");
  assert(did_controller.lookup(did_key) == controller, "Caller is not DID controller");
  assert(party_status.member(did_key), "DID not registered");
  assert(party_status.lookup(did_key) == (2 as Uint<8>), "DID is not active");
  // DID-linked color check (feature 005-coin-gated-admin-access, ADR-005):
  // el coin presentado debe ser específicamente el vinculado a ESTE DID, no
  // cualquier color válido de valid_colors. No requiere member() guard previo:
  // los tres asserts de arriba ya garantizan que did_token_color tiene una
  // entrada para este did_key (se inserta unconditionally en
  // gated_self_register_did en la misma tx que crea did_controller[did_key]).
  assert(disclose(coin.color) == did_token_color.lookup(did_key), "Token does not match this DID");

  consumeToken(coin);

  document_commitments.insert(did_key, disclose(doc_commitment));
  update_cap_commitments.insert(did_key, disclose(cap_commitment));
  party_status.insert(did_key, 4 as Uint<8>);
}

// === GATEADO: emisión de DID (solo Admin, feature 005-coin-gated-admin-access, ADR-004 — ISSUER eliminado) ===
export circuit issue_did(
                 coin: ShieldedCoinInfo,
                 did_key: Bytes<32>,
                 did_commitment: Bytes<32>,
                 doc_commitment: Bytes<32>,
                 proof_commitment: Bytes<32>
                 ): [] {
  consumeAdminToken(coin);

  const public_did_key = disclose(did_key);
  const public_did_commitment = disclose(did_commitment);
  const public_doc_commitment = disclose(doc_commitment);
  const public_proof_commitment = disclose(proof_commitment);
  assert(did_controller.member(public_did_key), "DID not registered");
  assert(party_status.member(public_did_key), "DID not registered");
  assert(party_status.lookup(public_did_key) == (1 as Uint<8>), "DID is not pending issuance");

  did_commitments.insert(public_did_key, public_did_commitment);
  document_commitments.insert(public_did_key, public_doc_commitment);
  proof_commitments.insert(public_did_key, public_proof_commitment);
  party_status.insert(public_did_key, 2 as Uint<8>);
  total_active_dids = (total_active_dids + (1 as Uint<64>)) as Uint<64>;
}

// === GATEADO: grant role (feature 005-coin-gated-admin-access, ADR-004) ===
export circuit grant_role(coin: ShieldedCoinInfo, did_key: Bytes<32>, role: Bytes<32>): [] {
  consumeAdminToken(coin);
  const public_did_key = disclose(did_key);
  assert(did_controller.member(public_did_key), "DID not registered");
  const public_role = disclose(role);
  const target = did_controller.lookup(public_did_key);
  role_by_key.insert(roleKey(target, public_role), true);
}

// === GATEADO: revoke role (feature 005-coin-gated-admin-access, ADR-004) ===
export circuit revoke_role(coin: ShieldedCoinInfo, did_key: Bytes<32>, role: Bytes<32>): [] {
  consumeAdminToken(coin);
  const public_did_key = disclose(did_key);
  assert(did_controller.member(public_did_key), "DID not registered");
  const public_role = disclose(role);
  const target = did_controller.lookup(public_did_key);
  role_by_key.insert(roleKey(target, public_role), false);
}

// === GATEADO: rotación atómica del admin token (feature 005-coin-gated-admin-access, ADR-003, REQ-04) ===
// Burn-then-remint en una única tx: el holder actual quema su admin token
// (o el de otro holder que le fue delegado) y mintea uno nuevo para el
// recipient elegido (puede ser el mismo caller u otra parte). El burn y el
// mint ocurren en el mismo cuerpo de circuit, por lo que se ejecutan como
// una unidad atómica de la transacción — no existe estado intermedio donde
// el token viejo esté quemado pero ninguno nuevo exista todavía.
export circuit rotate_admin_tokens(
                 coin: ShieldedCoinInfo,
                 new_recipient: ZswapCoinPublicKey,
                 new_coin_nonce: Bytes<32>,
                 new_supply: Uint<64>
                 ): [] {
  assert(disclose(coin.color) == admin_token_color, "Invalid admin token color");
  assert(disclose(coin.value) >= (1 as Uint<128>), "Insufficient admin token value");
  // Fix de diseño (post-tasks 3/8, 2026-07-09): new_supply debe ser >= 1 antes
  // de usarlo para calcular total/mintear — mismo patrón que admin_supply en
  // el constructor. Evita un remint degenerado con solo el 1 anchor unit y
  // ningún admin credit utilizable tras la rotación.
  assert(disclose(new_supply) >= (1 as Uint<64>), "new_supply must be at least 1");
  // Nullifier namespaced por color (fix post-quality-gate), consistente con
  // consumeToken()/consumeAdminToken() — mismo mapa compartido.
  const nullifier_proxy = persistentHash<Vector<2, Bytes<32>>>(
                             [disclose(coin.color), disclose(coin.nonce)]
                             );
  assert(!used_capability_nullifiers.member(nullifier_proxy), "Admin token already used");
  receiveShielded(disclose(coin));
  used_capability_nullifiers.insert(nullifier_proxy, true);

  const total = (disclose(new_supply) + (1 as Uint<64>)) as Uint<64>;

  mintShieldedToken(
    adminDomainSep(),
    total,
    disclose(new_coin_nonce),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(new_recipient))
    );
}

// === GATEADO: revoke DID (feature 005-coin-gated-admin-access, ADR-004) ===
export circuit revoke_did(coin: ShieldedCoinInfo, did_key: Bytes<32>): [] {
  consumeAdminToken(coin);
  const public_did_key = disclose(did_key);
  assert(did_controller.member(public_did_key), "DID not registered");
  assert(party_status.member(public_did_key), "DID not registered");
  assert(party_status.lookup(public_did_key) == (2 as Uint<8>), "DID is not active");
  party_status.insert(public_did_key, 3 as Uint<8>);
  if (total_active_dids > (0 as Uint<64>)) {
    total_active_dids = (total_active_dids - (1 as Uint<64>)) as Uint<64>;
  }
}

export circuit contract_version(): Bytes<32> {
  return pad(32, "3.0.0");
}
