pragma language_version >= 0.23 && <= 0.23;

import CompactStandardLibrary;

export ledger capability_commitments: Map<Bytes<32>, Bytes<32>>;

// Tracks colors minted by this contract — consume_token_for_action rejects any other color.
export ledger valid_colors: Map<Bytes<32>, Boolean>;

export circuit mint_capability_tokens(
                 subscription_key: Bytes<32>,
                 recipient: ZswapCoinPublicKey,
                 coin_nonce: Bytes<32>,
                 amount: Uint<64>
                 ): [] {
  assert(amount >= (1 as Uint<64>), "Amount must be >= 1");

  const public_sub_key = disclose(subscription_key);
  const public_recipient = disclose(recipient);
  const public_coin_nonce = disclose(coin_nonce);
  const public_amount = disclose(amount);

  // Color is unique per user, derived from the admin-chosen subscription_key.
  const domain_sep = persistentHash<Bytes<32>>(public_sub_key);

  // Mint amount+1: 1 unit is the anchor (proves ongoing subscription), rest are actions.
  const total = (public_amount + (1 as Uint<64>)) as Uint<64>;

  mintShieldedToken(
    domain_sep,
    total,
    public_coin_nonce,
    left<ZswapCoinPublicKey, ContractAddress>(public_recipient)
    );

  // Register the color so consume_token_for_action can verify it.
  const minted_color = tokenType(domain_sep, kernel.self());
  if (!valid_colors.member(minted_color)) {
    valid_colors.insert(minted_color, true);
  }
}

// The caller sends a ShieldedCoinInfo (nonce, color, value) as a circuit parameter.
// The DApp TypeScript generates a fresh nonce; the wallet's balanceUnsealedTransaction
// handles spending the user's actual wallet coin (with mt_index) internally — the DApp
// and this circuit never need mt_index.
//
// Flow: contract receives the coin, verifies color and value, returns all-but-1 unit
// to ownPublicKey() immediately in the same transaction (the 1 consumed unit is the
// action fee). The coin's nonce becomes a one-time nullifier_proxy preventing replay.
export circuit consume_token_for_action(
                 coin: ShieldedCoinInfo,
                 action_type: Bytes<32>,
                 did_key: Bytes<32>
                 ): [] {
  const public_nonce  = disclose(coin.nonce);
  const public_color  = disclose(coin.color);
  const public_value  = disclose(coin.value);
  const public_action = disclose(action_type);
  const public_did    = disclose(did_key);

  // Only tokens minted by this contract are accepted.
  assert(valid_colors.member(public_color), "Invalid token color");

  // Anchor protection: must retain >= 1 unit after consuming 1.
  assert(public_value >= (2 as Uint<128>), "Anchor token: value must be >= 2");

  // Replay protection: each coin nonce can only gate one action.
  const nullifier_proxy = persistentHash<Bytes<32>>(public_nonce);
  assert(!capability_commitments.member(nullifier_proxy), "Token already used");

  // Contract takes custody of the coin (wallet balances the Zswap spend side).
  receiveShielded(disclose(coin));

  // Return all-but-1 unit back to the caller in the same transaction.
  const remaining = (public_value - (1 as Uint<128>)) as Uint<128>;
  sendImmediateShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    remaining
    );

  // Commitment = hash(action_type, contract_addr, did_key, color, nullifier_proxy).
  // This is read by the DID registry's assertCapabilityProof — formula is unchanged.
  const self_bytes = kernel.self().bytes;
  const commitment =
          persistentHash<Vector<5, Bytes<32>>>(
            [public_action, self_bytes, public_did, public_color, nullifier_proxy]
            );

  capability_commitments.insert(nullifier_proxy, commitment);
}
