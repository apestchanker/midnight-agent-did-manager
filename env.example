# Midnight Preprod frontend configuration
VITE_NETWORK_ID=preprod
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v3/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
VITE_NODE_URI=https://rpc.preprod.midnight.network
VITE_PROVER_SERVER_URI=http://127.0.0.1:6300
VITE_MANAGED_CONTRACT_PATH=/contracts/managed/did-registry
VITE_APP_TITLE="Midnight Agent DID Manager"

# Alternative Preview network configuration
# Uncomment and replace the values above if you want to target Preview instead of Preprod.
# VITE_NETWORK_ID=preview
# VITE_INDEXER_URI=https://indexer.preview.midnight.network/api/v3/graphql
# VITE_INDEXER_WS_URI=wss://indexer.preview.midnight.network/api/v3/graphql/ws
# VITE_NODE_URI=https://rpc.preview.midnight.network
# VITE_PROVER_SERVER_URI=http://127.0.0.1:6300

# DID service / MCP API
VITE_DID_API_BASE_URL=http://localhost:8787
DID_API_PORT=8787
DID_MCP_PORT=8788
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD_HERE@127.0.0.1:5432/agent_registry_db

# DEPRECATED — no longer read anywhere in the codebase (confirmed by grep;
# only stale explanatory comments referencing the old names remain in
# server/index.js and server/mcp-http.js). Previously, these gated private
# REST routes and the MCP /logs endpoint with a single shared token sent as
# X-DID-API-Key or Authorization: Bearer. Feature 007
# (wallet-nonce-session-auth, below) replaced this shared-secret gate with a
# per-wallet challenge-response login, in a hard cutover with no dual-accept
# window — setting these variables has no effect on any route. Safe to
# remove entirely; left here, commented out, only as a breadcrumb for anyone
# who finds them referenced in old deploy configs.
# DID_API_AUTH_TOKEN=replace-with-a-long-random-token
# VITE_DID_API_AUTH_TOKEN=replace-with-a-long-random-token

# Wallet nonce + session auth (feature 007): challenge-response login that
# replaces the deprecated DID_API_AUTH_TOKEN above for human/admin routes.
# See sdd/wip/007-wallet-nonce-session-auth/2-technical/spec.md. The five
# variables below (DID_ADMIN_WALLET_ADDRESS, DID_AUTH_NONCE_TTL_SECONDS,
# DID_SESSION_TTL_SECONDS, DID_AUTH_DOMAIN, DID_NETWORK_ID) are the real,
# currently-read configuration for this mechanism.
#
# DID_ADMIN_WALLET_ADDRESS is the UNSHIELDED Bech32m address of the admin
# wallet. IMPORTANT: this is NOT the same value as VITE_ADMIN_WALLET_SHIELDED_ADDR
# above — that one is a SHIELDED address used only for frontend display.
# Comparing a session's derived (unshielded) wallet address against the
# shielded value would silently and permanently break admin auth. If unset,
# no session is ever treated as admin (fail-closed).
DID_ADMIN_WALLET_ADDRESS=replace-with-the-admin-wallets-unshielded-address

# Challenge (nonce) lifetime, in seconds. Default: 300 (5 minutes).
DID_AUTH_NONCE_TTL_SECONDS=300

# Session lifetime, in seconds. Recommended range: 1800-3600 (30-60 minutes).
DID_SESSION_TTL_SECONDS=1800

# Domain-separation tag embedded in the login challenge envelope, e.g. the
# deployed hostname. Prevents a challenge signed for one deployment from
# being replayed against another.
DID_AUTH_DOMAIN=localhost

# Network used server-side to Bech32m-encode the wallet address derived from
# a login signature (server/session-service.js -> encodeDerivedWalletAddress).
# MUST match the VITE_NETWORK_ID of the frontend build for this same deploy
# (see the top of this file) — a mismatch here would encode the derived
# address with the wrong network HRP, making it silently fail to match the
# declared wallet address on every login. Falls back to "preprod" if unset.
DID_NETWORK_ID=preprod

# Loopback binding and CORS allowlist (defaults shown).
DID_API_HOST=127.0.0.1
DID_MCP_HOST=127.0.0.1
DID_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional admin wallet override for UI role gating
VITE_ADMIN_WALLET_SHIELDED_ADDR=mn_shield-addr_XXXXXXXX

# Owner authorization now uses a random local vault secret stored in Midnight
# private state. Export an encrypted backup from the UI after deployment.
# Backup passwords must be at least 10 characters.
